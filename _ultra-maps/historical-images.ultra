---
type: dsv
style:
  layers:
    - type: circle
      circle-radius: 5
    - type: symbol
      icon-overlap: always
      filter: [!=, direction, '']
      icon-size:
        stops:
          - [5, 0]
          - [15, 1]
      icon-rotate: [to-number, [get, direction]]
      icon-image: https://maprva.org/img/surveillance-direction.png
---
