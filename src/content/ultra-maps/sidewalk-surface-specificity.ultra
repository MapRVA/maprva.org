---
server: https://overpass.maprva.org/api
style:
  extends: https://styles.maprva.org/vgin-vbmp-imagery-latest.json
  layers:
    - type: raster
      source: imagery
    - type: line
      line-width: 4
      line-color: &color
        - case
        - [has, surface]
        - - match
          - [ get, surface ]
          - [ paved, unpaved ]
          - orange
          - green
        - red
---
[bbox:{{bbox}}];
(
  way[highway~"footway|steps"];
);
out geom;
