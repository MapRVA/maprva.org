---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { formatDay, formatMonth, formatWeekday, formatTime } from "../utils/date";

const events = await getCollection("events");
const upcoming = events.sort((a, b) => {
    const da = new Date(a.data.start.dateTime || a.data.start.date || 0);
    const db = new Date(b.data.start.dateTime || b.data.start.date || 0);
    return da.getTime() - db.getTime();
});

const pastEventsRaw = await getCollection("pastEvents");
const past = pastEventsRaw.sort((a, b) => {
    const da = new Date(a.data.start.dateTime || a.data.start.date || 0);
    const db = new Date(b.data.start.dateTime || b.data.start.date || 0);
    return db.getTime() - da.getTime(); // most recent first
});
---

<PageLayout title="Events · MapRVA">
    <section>
        <h1 class="text-4xl font-bold mb-8">Upcoming Events</h1>

        Our events calendar is also available <a href="https://calendar.google.com/calendar/embed?src=mappingrva%40gmail.com&ctz=America%2FNew_York">HERE</a> via Google Calendar if you'd like to subscribe to it!

        {upcoming.length === 0 && (
            <div class="card bg-base-100 shadow-lg p-8">
                <p class="text-center opacity-50">No upcoming events — check back soon!</p>
            </div>
        )}

        {upcoming.length > 0 && (
            <div class="card bg-base-100 shadow-lg p-6 md:p-8">
                <div class="divide-y divide-base-300">
                    {upcoming.map((event) => (
                        <div class="flex items-start gap-5 py-4 first:pt-0 last:pb-0">
                            <div class="flex flex-col items-center justify-center min-w-14 p-2 rounded-lg bg-primary">
                                <span class="text-[0.65rem] font-bold uppercase tracking-wide text-primary-content/70">
                                    {formatMonth(event.data.start)}
                                </span>
                                <span class="text-2xl font-bold leading-none text-primary-content">
                                    {formatDay(event.data.start)}
                                </span>
                                <span class="text-[0.65rem] text-primary-content/50">
                                    {formatWeekday(event.data.start)}
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="font-bold text-lg leading-snug">
                                    {event.data.htmlLink ? (
                                        <a
                                            href={event.data.htmlLink}
                                            target="_blank"
                                            rel="noopener"
                                            class="link link-hover text-base-content hover:text-primary transition-colors"
                                        >
                                            {event.data.summary}
                                        </a>
                                    ) : (
                                        event.data.summary
                                    )}
                                </h3>
                                <div class="flex flex-wrap items-center gap-2 mt-1.5">
                                    <span class="badge badge-sm badge-ghost gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                        </svg>
                                        {formatTime(event.data.start)}
                                    </span>
                                    {event.data.location && (
                                        <span class="badge badge-sm badge-ghost gap-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                            </svg>
                                            <span class="truncate max-w-[20ch] sm:max-w-none">{event.data.location}</span>
                                        </span>
                                    )}
                                </div>
                                {event.data.description && (
                                    <div
                                        class="text-sm opacity-50 mt-2 line-clamp-2"
                                        set:html={event.data.description}
                                    />
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        )}
    </section>

    {past.length > 0 && (
        <section class="mt-12">
            <h2 class="text-3xl font-bold mb-8">Past Events</h2>
            <div class="card bg-base-100 shadow-lg p-6 md:p-8">
                <div class="divide-y divide-base-300">
                    {past.map((event) => (
                        <div class="flex items-start gap-5 py-4 first:pt-0 last:pb-0 opacity-70">
                            <div class="flex flex-col items-center justify-center min-w-14 p-2 rounded-lg bg-base-300">
                                <span class="text-[0.65rem] font-bold uppercase tracking-wide text-base-content/50">
                                    {formatMonth(event.data.start)}
                                </span>
                                <span class="text-2xl font-bold leading-none text-base-content/70">
                                    {formatDay(event.data.start)}
                                </span>
                                <span class="text-[0.65rem] text-base-content/40">
                                    {formatWeekday(event.data.start)}
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="font-bold text-lg leading-snug">
                                    {event.data.htmlLink ? (
                                        <a
                                            href={event.data.htmlLink}
                                            target="_blank"
                                            rel="noopener"
                                            class="link link-hover text-base-content hover:text-primary transition-colors"
                                        >
                                            {event.data.summary}
                                        </a>
                                    ) : (
                                        event.data.summary
                                    )}
                                </h3>
                                <div class="flex flex-wrap items-center gap-2 mt-1.5">
                                    <span class="badge badge-sm badge-ghost gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                        </svg>
                                        {formatTime(event.data.start)}
                                    </span>
                                    {event.data.location && (
                                        <span class="badge badge-sm badge-ghost gap-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                            </svg>
                                            <span class="truncate max-w-[20ch] sm:max-w-none">{event.data.location}</span>
                                        </span>
                                    )}
                                </div>
                                {event.data.description && (
                                    <div
                                        class="text-sm opacity-50 mt-2 line-clamp-2"
                                        set:html={event.data.description}
                                    />
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )}
</PageLayout>
