---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import PeopleGrid from "../../components/PeopleGrid.astro";
import { base } from "../../utils/base";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { title, blurb, image, buttons, roles } = project.data;
const { Content } = await render(project);

const primaryButton = buttons[0];
const secondaryButtons = buttons.slice(1);

/* Look up people referenced by this project's roles */
const people = await getCollection("people");
const peopleLookup = Object.fromEntries(people.map((p) => [p.id, p]));
const contributors = (roles ?? [])
    .map((role) => {
        const p = peopleLookup[role.person];
        return p ? { ...p, roleTitle: role.title } : null;
    })
    .filter((c) => c != null);
---

<PageLayout title={`${title} — MapRVA`}>
    <div class:list={["cover", { "cover-no-image": !image }]}>
        <div class="cover-inner">
            <h1>{title}</h1>
            <hr class="cover-hr" />
            {blurb && <p class="blurb">{blurb}</p>}
            {buttons.length > 0 && (
                <div class="flex flex-wrap gap-3 mt-6">
                    {primaryButton && (
                        <a href={primaryButton.link} class="btn btn-lg btn-primary" target="_blank" rel="noopener">
                            {primaryButton.label}
                        </a>
                    )}
                    {secondaryButtons.map((btn) => (
                        <a href={btn.link} class="btn btn-lg btn-outline cover-btn-outline" target="_blank" rel="noopener">
                            {btn.label}
                        </a>
                    ))}
                </div>
            )}
        </div>
    </div>

    {image && (
        <div class="project-image">
            <img src={image.startsWith("/") ? base(image) : image} alt={title} />
        </div>
    )}

    <article class="prose max-w-none">
        <Content />
    </article>

    {contributors.length > 0 && (
        <div class="my-8">
            <hr class="my-6" />
            <h2 class="text-[2rem] leading-[1.2] font-bold mb-4">People</h2>
            <PeopleGrid justify="left" items={contributors.map((c) => ({
                name: c.data.title,
                title: c.roleTitle,
                image: c.data.image,
                href: base(`/people/${c.id}`),
            }))} />
        </div>
    )}

    <a href={base("/projects")} class="btn btn-sm btn-outline mt-6">← All projects</a>
</PageLayout>

<style>
    .cover {
        background-color: var(--color-neutral);
        color: white;
        padding: 4rem 24px calc(10em + 1.5rem);
        margin-bottom: 0;

        /* break out of the max-width container to span full viewport */
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;
    }

    .cover-no-image {
        padding-bottom: 2rem;
        margin-bottom: 2rem;
    }

    .cover-inner {
        max-width: 64rem;
        margin: 0 auto;
        padding: 0 1.5em;
    }

    .cover h1 {
        font-family: var(--logo-font, "Crimson Pro", serif);
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin: 0;
        color: white;
    }

    .cover-hr {
        border: none;
        border-top: 1px solid color-mix(in oklch, var(--color-neutral-content) 25%, transparent);
        margin: 1rem 0;
    }

    .blurb {
        font-size: 1.15rem;
        line-height: 1.6;
        font-weight: 300;
        color: color-mix(in oklch, var(--color-neutral-content) 75%, transparent);
        margin-top: 1rem;
    }

    .cover-btn-outline {
        border-color: color-mix(in oklch, var(--color-neutral-content) 30%, transparent);
        color: var(--color-neutral-content);
    }

    .cover-btn-outline:hover {
        background: color-mix(in oklch, var(--color-neutral-content) 10%, transparent);
        border-color: color-mix(in oklch, var(--color-neutral-content) 50%, transparent);
    }

    .project-image {
        margin-top: -10em;
        margin-bottom: 2rem;
        position: relative;
    }

    .project-image img {
        width: 100%;
        display: block;
        object-fit: cover;
        border-radius: 0.5rem;
    }
</style>
